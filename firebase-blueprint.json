  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private profile and active school pointer for a user."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role lookup collection."
    },
    "/studentPortals/{registrationCode}": {
      "schema": { "$ref": "#/entities/StudentPortal" },
      "description": "Non-enumerable registration code header for student exam results login without email."
    },
    "/studentPortals/{registrationCode}/results/{assessmentId}": {
      "schema": { "$ref": "#/entities/StudentPortalResult" },
      "description": "Student exam results readable only via their administrator-issued registration code."
    },
    "/studentPortals/{registrationCode}/libraryLoans/{loanId}": {
      "schema": { "$ref": "#/entities/StudentPortalLibraryLoan" },
      "description": "Student borrowed library books and due dates readable only via their registration code."
    },
    "/studentPortals/{registrationCode}/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/LibraryReservation" },
      "description": "Student library book reservations readable and requestable via their registration code."
    },
    "/studentLibraries/{schoolId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/CatalogBookMirror" },
      "description": "Zero-PII school book availability catalog readable by students in that school."
    },
    "/studentLibraries/{schoolId}/digitalResources/{resourceId}": {
      "schema": { "$ref": "#/entities/DigitalLibraryResource" },
      "description": "Published non-downloadable digital books and past papers readable by students in that school."
    },
    "/studentLinks/{linkId}": {
      "schema": { "$ref": "#/entities/StudentLink" },
      "description": "Student email-to-enrollment index enabling verified students to locate their own exam results."
    },
    "/staffLinks/{linkId}": {
      "schema": { "$ref": "#/entities/StaffLink" },
      "description": "Staff email-to-school index enabling teachers, bursars, and deputy heads to open their assigned workspace."
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Secondary school workspace owned by an authenticated user."
    },
    "/schools/{schoolId}/staffAccess/{staffKey}": {
      "schema": { "$ref": "#/entities/StaffAccess" },
      "description": "Role-Based Access Control (RBAC) membership documents for school staff."
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students enrolled in the school."
    },
    "/schools/{schoolId}/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Teaching and administrative staff in the school."
    },
    "/schools/{schoolId}/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "MANEB JCE/MSCE subject marks and grades."
    },
    "/schools/{schoolId}/feeInvoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/FeeInvoice" },
      "description": "Student term fee invoices in MWK."
    },
    "/schools/{schoolId}/feePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/FeePayment" },
      "description": "Immutable MWK fee payment receipts."
    },
    "/schools/{schoolId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily student attendance records."
    },
    "/schools/{schoolId}/smsSettings/{configId}": {
      "schema": { "$ref": "#/entities/SmsConfig" },
      "description": "Automated parent SMS notification policy configuration per school."
    },
    "/schools/{schoolId}/smsLogs/{smsId}": {
      "schema": { "$ref": "#/entities/SmsLog" },
      "description": "Immutable audit log of fee confirmation and low balance SMS alerts dispatched to guardians."
    },
    "/schools/{schoolId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/SchoolSubject" },
      "description": "School-defined curriculum subjects mapped to Form 1-4."
    },
    "/schools/{schoolId}/libraryLoans/{loanId}": {
      "schema": { "$ref": "#/entities/LibraryLoan" },
      "description": "Textbooks and reading materials checked out to students with due dates and return status."
    },
    "/schools/{schoolId}/libraryBooks/{bookId}": {
      "schema": { "$ref": "#/entities/LibraryBook" },
      "description": "Available book inventory catalog with ISBN, title, author, subject, and copy counts."
    },
    "/schools/{schoolId}/libraryTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/LibraryTransaction" },
      "description": "Immutable audit trail of library borrowing activity (checkouts, returns, reopens, edits, and deletions)."
    },
    "/schools/{schoolId}/libraryReservations/{reservationId}": {
      "schema": { "$ref": "#/entities/LibraryReservation" },
      "description": "Student reservation requests for checked-out library books managed by librarians."
    },
    "/schools/{schoolId}/digitalLibrary/{resourceId}": {
      "schema": { "$ref": "#/entities/DigitalLibraryResource" },
      "description": "Online & offline digital library collection (non-downloadable books, set books, and past papers)."
    }
  }
