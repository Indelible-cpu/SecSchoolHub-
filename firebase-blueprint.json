        "ca1Max": { "type": "number" },
        "ca1Score": { "type": "number" },
        "ca2Raw": { "type": "number" },
        "ca2Max": { "type": "number" },
        "ca2Score": { "type": "number" },
        "caScore": { "type": "number" },
        "examRaw": { "type": "number" },
        "examMax": { "type": "number" },
        "examScore": { "type": "number" },
        "totalScore": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "gradePoint": { "type": "number" },
        "remark": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "studentId",
        "studentName",
        "studentEmail",
        "formLevel",
        "stream",
        "term",
        "academicYear",
        "subject",
        "ca1Raw",
        "ca1Max",
        "ca1Score",
        "ca2Raw",
        "ca2Max",
        "ca2Score",
        "caScore",
        "examRaw",
        "examMax",
        "examScore",
        "totalScore",
        "grade",
        "gradePoint",
        "remark",
        "createdAt",
        "updatedAt"
      ]
    },
    "FeeInvoice": {
      "title": "Term Fee Invoice",
      "description": "Student term fee statement in Malawi Kwacha (MWK).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
