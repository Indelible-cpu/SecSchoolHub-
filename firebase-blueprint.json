{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user workspace configuration for a signed-in school administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "activeSchoolId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "activeSchoolId", "createdAt", "updatedAt"]
    },
    "School": {
      "title": "Secondary School",
      "description": "Malawi secondary school configuration, term calendar, and fee defaults.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "district": { "type": "string", "maxLength": 60 },
        "schoolType": {
          "type": "string",
          "enum": ["Government Day", "Government Boarding", "Grant-Aided", "Private"],
          "maxLength": 40
        },
        "motto": { "type": "string", "maxLength": 140 },
        "academicYear": { "type": "string", "maxLength": 20 },
        "currentTerm": {
          "type": "string",
          "enum": ["Term 1", "Term 2", "Term 3"],
          "maxLength": 20
        },
        "defaultTuitionMWK": { "type": "number" },
        "defaultGpfMWK": { "type": "number" },
        "defaultExamFeeMWK": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "name",
        "district",
        "schoolType",
        "motto",
        "academicYear",
        "currentTerm",
        "defaultTuitionMWK",
        "defaultGpfMWK",
        "defaultExamFeeMWK",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Secondary school student enrolled in Form 1 to Form 4.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "admissionNo": { "type": "string", "maxLength": 40 },
        "fullName": { "type": "string", "maxLength": 120 },
        "gender": { "type": "string", "enum": ["Male", "Female"], "maxLength": 10 },
        "formLevel": { "type": "number" },
        "stream": { "type": "string", "maxLength": 20 },
        "entryYear": { "type": "number", "description": "4-digit year of entry (e.g., 2026)." },
        "boardingStatus": {
          "type": "string",
          "enum": ["Day Scholar", "Boarder"],
          "maxLength": 20
        },
        "guardianName": { "type": "string", "maxLength": 120 },
        "guardianPhone": { "type": "string", "maxLength": 30 },
        "guardianSecondaryPhone": { "type": "string", "maxLength": 30 },
        "guardianRelationship": { "type": "string", "maxLength": 40 },
        "emergencyContactName": { "type": "string", "maxLength": 120 },
        "emergencyContactPhone": { "type": "string", "maxLength": 30 },
        "emergencyNotes": { "type": "string", "maxLength": 240 },
        "studentEmail": { "type": "string", "maxLength": 160 },
        "registrationCode": { "type": "string", "maxLength": 32, "pattern": "^[A-Z0-9_\\-]*$" },
        "status": {
          "type": "string",
          "enum": ["Active", "Transferred", "Suspended", "Graduated"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "admissionNo",
        "fullName",
        "gender",
        "formLevel",
        "stream",
        "boardingStatus",
        "guardianName",
        "guardianPhone",
        "studentEmail",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Teacher": {
      "title": "Teacher & Staff",
      "description": "Teaching and administrative staff member.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
