          && incoming().studentId == existing().studentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewNote', 'receiptNo', 'invoiceId', 'updatedAt'
            ])
          );
        allow delete: if isValidId(schoolId) && isValidId(submissionId) && isBursarStaff(schoolId);
      }

      // Attendance records: Readable by academic staff (for turnout monitoring), writable ONLY by Form Teachers (or School Owner impersonating Form Teacher in dev)
      match /attendance/{attendanceId} {
