rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function isAdmin() {
      return isVerified() && (
        ('email' in request.auth.token && request.auth.token.email is string && (request.auth.token.email.lower() == 'firestore730@gmail.com' || request.auth.token.email.lower() == 'dicksonpetroj1@gmail.com')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRegCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 32 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function schoolOwnerId(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId;
    }

    function isSchoolOwner(schoolId) {
      return isVerified() && (
        isAdmin() ||
        schoolOwnerId(schoolId) == request.auth.uid
      );
    }

    function staffAccessKey(email) {
      return 'stf_' + email.lower().replace('[^a-z0-9]', '_');
    }

    function hasStaffAccess(schoolId) {
      return isVerified()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 3
        && exists(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email)))
        && get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.staffEmail == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.status == 'Active';
    }

    function staffRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.roleTitle;
    }

    function staffTeacherId(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.teacherId;
    }

    function blantyreTime(ts) {
      return ts + duration.value(2, 'h');
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function formatLocalDate(localTs) {
      return string(localTs.year()) + '-' + pad2(localTs.month()) + '-' + pad2(localTs.day());
    }

    function localTotalMinutes(localTs) {
      return localTs.hours() * 60 + localTs.minutes();
    }

    function parseHHMMMinutes(hhmm) {
      return int(hhmm[0:2]) * 60 + int(hhmm[3:5]);
    }

    function isWithinTimebookWindow(schoolId, roleTitle) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default)
        ? (
            get(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default).data.enabled == true &&
            localTotalMinutes(blantyreTime(request.time)) >= parseHHMMMinutes(get(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default).data.windowStartHHMM) &&
            localTotalMinutes(blantyreTime(request.time)) < (
              roleTitle in get(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default).data.categoryDeadlines
                ? parseHHMMMinutes(get(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default).data.categoryDeadlines[roleTitle])
                : parseHHMMMinutes(get(/databases/$(database)/documents/schools/$(schoolId)/timebookSettings/default).data.defaultDeadlineHHMM)
            )
          )
        : (
            localTotalMinutes(blantyreTime(request.time)) >= 330 &&
            localTotalMinutes(blantyreTime(request.time)) < 480
          );
    }

    function isSchoolHead(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in ['Head Teacher', 'Deputy Head']
      );
    }

    function isFormTeacherStaff(schoolId) {
      return hasStaffAccess(schoolId) && staffRole(schoolId) in ['Form Teacher', 'Form Master'];
    }

    function isAcademicStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in [
          'Head Teacher', 'Deputy Head', 'Head of Department', 'Form Teacher', 'Form Master', 'Subject Teacher'
        ]
      );
    }

    function isBursarStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in ['Head Teacher', 'School Bursar']
      );
    }

    function isLibraryStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in [
          'Head Teacher', 'Deputy Head', 'School Librarian',
          'Head of Department', 'Form Teacher', 'Form Master', 'Subject Teacher'
        ]
      );
    }

    function isAnySchoolStaff(schoolId) {
      return isSchoolOwner(schoolId) || hasStaffAccess(schoolId);
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'activeSchoolId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'activeSchoolId', 'photoDataUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isValidId(data.activeSchoolId)
        && (!('photoDataUrl' in data) || isValidLogoDataUrl(data.photoDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogoDataUrl(val) {
      return val is string && (
        val == '' ||
        (val.size() >= 22 && val.size() <= 160000 && val.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$'))
      );
    }

    function isValidSchool(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'district', 'schoolType', 'motto',
          'academicYear', 'currentTerm', 'defaultTuitionMWK', 'defaultGpfMWK',
          'defaultExamFeeMWK', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'district', 'schoolType', 'motto',
          'academicYear', 'currentTerm', 'defaultTuitionMWK', 'defaultGpfMWK',
          'defaultExamFeeMWK', 'logoDataUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.schoolType in ['Government Day', 'Government Boarding', 'Grant-Aided', 'Private']
        && data.motto is string && data.motto.size() <= 140
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.currentTerm in ['Term 1', 'Term 2', 'Term 3']
        && data.defaultTuitionMWK is number && data.defaultTuitionMWK >= 0 && data.defaultTuitionMWK <= 100000000
        && data.defaultGpfMWK is number && data.defaultGpfMWK >= 0 && data.defaultGpfMWK <= 100000000
        && data.defaultExamFeeMWK is number && data.defaultExamFeeMWK >= 0 && data.defaultExamFeeMWK <= 100000000
        && (!('logoDataUrl' in data) || isValidLogoDataUrl(data.logoDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
          'ownerId', 'admissionNo', 'fullName', 'gender', 'formLevel', 'stream',
          'boardingStatus', 'guardianName', 'guardianPhone', 'studentEmail',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'admissionNo', 'fullName', 'gender', 'formLevel', 'stream',
          'entryYear', 'boardingStatus', 'guardianName', 'guardianPhone', 'guardianSecondaryPhone',
          'guardianRelationship', 'emergencyContactName', 'emergencyContactPhone',
          'emergencyNotes', 'studentEmail', 'registrationCode', 'photoDataUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.gender in ['Male', 'Female']
        && data.formLevel is int && data.formLevel >= 1 && data.formLevel <= 4
        && data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 20
        && (!('entryYear' in data) || (data.entryYear is int && data.entryYear >= 2000 && data.entryYear <= 2100))
        && data.boardingStatus in ['Day Scholar', 'Boarder']
        && data.guardianName is string && data.guardianName.size() >= 1 && data.guardianName.size() <= 120
        && data.guardianPhone is string && data.guardianPhone.size() <= 30
        && (!('guardianSecondaryPhone' in data) || (data.guardianSecondaryPhone is string && data.guardianSecondaryPhone.size() <= 30))
        && (!('guardianRelationship' in data) || (data.guardianRelationship is string && data.guardianRelationship.size() <= 40))
        && (!('emergencyContactName' in data) || (data.emergencyContactName is string && data.emergencyContactName.size() <= 120))
        && (!('emergencyContactPhone' in data) || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() <= 30))
        && (!('emergencyNotes' in data) || (data.emergencyNotes is string && data.emergencyNotes.size() <= 240))
        && data.studentEmail is string && data.studentEmail.size() <= 160
        && (!('registrationCode' in data) || (data.registrationCode is string && data.registrationCode.size() <= 32))
        && (!('photoDataUrl' in data) || isValidLogoDataUrl(data.photoDataUrl))
        && data.status in ['Active', 'Transferred', 'Suspended', 'Rusticated', 'Graduated']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll([
          'ownerId', 'staffCode', 'fullName', 'roleTitle', 'subjects',
          'assignedForm', 'phone', 'staffEmail', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'staffCode', 'fullName', 'roleTitle', 'subjects',
          'assignedForm', 'phone', 'staffEmail', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.staffCode is string && data.staffCode.size() >= 1 && data.staffCode.size() <= 40
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.roleTitle in [
          'Head Teacher', 'Deputy Head', 'Head of Department',
          'Form Teacher', 'Form Master', 'Subject Teacher', 'School Librarian', 'School Bursar'
        ]
        && data.subjects is list && data.subjects.size() >= 1 && data.subjects.size() <= 8
        && data.subjects[0] is string && data.subjects[0].size() <= 60
        && data.assignedForm is string && data.assignedForm.size() >= 1 && data.assignedForm.size() <= 30
        && data.phone is string && data.phone.size() <= 30
        && data.staffEmail is string && data.staffEmail.size() <= 120
        && data.status in ['Active', 'On Leave']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffAccess(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'teacherId', 'staffEmail', 'roleTitle',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolId', 'teacherId', 'staffEmail', 'roleTitle',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidId(data.teacherId)
        && data.staffEmail is string && data.staffEmail.size() >= 3 && data.staffEmail.size() <= 120
        && data.roleTitle in [
          'Head Teacher', 'Deputy Head', 'Head of Department',
          'Form Teacher', 'Form Master', 'Subject Teacher', 'School Librarian', 'School Bursar'
        ]
        && data.status in ['Active', 'On Leave']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffLink(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'academicYear', 'currentTerm', 'teacherId', 'staffName', 'staffCode',
          'roleTitle', 'subjects', 'assignedForm', 'staffEmail', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'academicYear', 'currentTerm', 'teacherId', 'staffName', 'staffCode',
          'roleTitle', 'subjects', 'assignedForm', 'staffEmail', 'status',
          'logoDataUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120
        && data.schoolDistrict is string && data.schoolDistrict.size() >= 2 && data.schoolDistrict.size() <= 60
        && data.schoolType in ['Government Day', 'Government Boarding', 'Grant-Aided', 'Private']
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.currentTerm in ['Term 1', 'Term 2', 'Term 3']
        && isValidId(data.teacherId)
        && data.staffName is string && data.staffName.size() >= 2 && data.staffName.size() <= 120
        && data.staffCode is string && data.staffCode.size() >= 1 && data.staffCode.size() <= 40
        && data.roleTitle in [
          'Head Teacher', 'Deputy Head', 'Head of Department',
          'Form Teacher', 'Form Master', 'Subject Teacher', 'School Librarian', 'School Bursar'
        ]
        && data.subjects is list && data.subjects.size() >= 1 && data.subjects.size() <= 8
        && data.subjects[0] is string && data.subjects[0].size() <= 60
        && data.assignedForm is string && data.assignedForm.size() >= 1 && data.assignedForm.size() <= 30
        && data.staffEmail is string && data.staffEmail.size() >= 3 && data.staffEmail.size() <= 120
        && data.status in ['Active', 'On Leave']
        && (!('logoDataUrl' in data) || isValidLogoDataUrl(data.logoDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssessment(data) {
      return data.keys().hasAll([
          'ownerId', 'studentId', 'studentName', 'studentEmail', 'formLevel', 'stream', 'term',
          'academicYear', 'subject',
          'ca1Raw', 'ca1Max', 'ca1Score',
          'ca2Raw', 'ca2Max', 'ca2Score',
          'caScore',
          'examRaw', 'examMax', 'examScore',
          'totalScore', 'grade', 'gradePoint', 'remark', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'studentId', 'studentName', 'studentEmail', 'formLevel', 'stream', 'term',
          'academicYear', 'subject',
          'ca1Raw', 'ca1Max', 'ca1Score',
          'ca2Raw', 'ca2Max', 'ca2Score',
          'caScore',
          'examRaw', 'examMax', 'examScore',
          'totalScore', 'grade', 'gradePoint', 'remark', 'teacherComment', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() <= 160
        && data.formLevel is int && data.formLevel >= 1 && data.formLevel <= 4
        && data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 20
        && data.term in ['Term 1', 'Term 2', 'Term 3']
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60
        && data.ca1Raw is number && data.ca1Raw >= 0 && data.ca1Raw <= 1000
        && data.ca1Max is number && data.ca1Max >= 0 && data.ca1Max <= 1000 && data.ca1Raw <= data.ca1Max
        && data.ca1Score is number && data.ca1Score >= 0 && data.ca1Score <= 20
        && data.ca2Raw is number && data.ca2Raw >= 0 && data.ca2Raw <= 1000
        && data.ca2Max is number && data.ca2Max >= 0 && data.ca2Max <= 1000 && data.ca2Raw <= data.ca2Max
        && data.ca2Score is number && data.ca2Score >= 0 && data.ca2Score <= 20
        && data.caScore is number && data.caScore >= 0 && data.caScore <= 40
        && data.examRaw is number && data.examRaw >= 0 && data.examRaw <= 1000
        && data.examMax is number && data.examMax >= 0 && data.examMax <= 1000 && data.examRaw <= data.examMax
        && data.examScore is number && data.examScore >= 0 && data.examScore <= 60
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 10
        && data.gradePoint is int && data.gradePoint >= 1 && data.gradePoint <= 9
        && data.remark is string && data.remark.size() >= 1 && data.remark.size() <= 40
        && (!('teacherComment' in data) || (data.teacherComment is string && data.teacherComment.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentLink(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'motto', 'academicYear', 'currentTerm', 'studentId', 'studentName',
          'admissionNo', 'formLevel', 'stream', 'boardingStatus', 'studentEmail',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'motto', 'academicYear', 'currentTerm', 'studentId', 'studentName',
          'admissionNo', 'formLevel', 'stream', 'boardingStatus', 'studentEmail',
          'logoDataUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120
        && data.schoolDistrict is string && data.schoolDistrict.size() >= 2 && data.schoolDistrict.size() <= 60
        && data.schoolType in ['Government Day', 'Government Boarding', 'Grant-Aided', 'Private']
        && data.motto is string && data.motto.size() <= 140
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.currentTerm in ['Term 1', 'Term 2', 'Term 3']
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40
        && data.formLevel is int && data.formLevel >= 1 && data.formLevel <= 4
        && data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 20
        && data.boardingStatus in ['Day Scholar', 'Boarder']
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 160
        && (!('logoDataUrl' in data) || isValidLogoDataUrl(data.logoDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentPortal(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'motto', 'academicYear', 'currentTerm', 'studentId', 'studentName',
          'admissionNo', 'formLevel', 'stream', 'boardingStatus', 'registrationCode',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolId', 'schoolName', 'schoolDistrict', 'schoolType',
          'motto', 'academicYear', 'currentTerm', 'studentId', 'studentName',
          'admissionNo', 'formLevel', 'stream', 'boardingStatus', 'registrationCode',
          'status', 'logoDataUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.schoolName is string && data.schoolName.size() >= 2 && data.schoolName.size() <= 120
        && data.schoolDistrict is string && data.schoolDistrict.size() >= 2 && data.schoolDistrict.size() <= 60
        && data.schoolType in ['Government Day', 'Government Boarding', 'Grant-Aided', 'Private']
        && data.motto is string && data.motto.size() <= 140
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.currentTerm in ['Term 1', 'Term 2', 'Term 3']
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.admissionNo is string && data.admissionNo.size() >= 1 && data.admissionNo.size() <= 40
        && data.formLevel is int && data.formLevel >= 1 && data.formLevel <= 4
        && data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 20
        && data.boardingStatus in ['Day Scholar', 'Boarder']
        && isValidRegCode(data.registrationCode)
        && data.status in ['Active', 'Transferred', 'Suspended', 'Rusticated', 'Graduated']
        && (!('logoDataUrl' in data) || isValidLogoDataUrl(data.logoDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortalResult(data) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'registrationCode', 'studentId', 'studentName',
          'formLevel', 'stream', 'term', 'academicYear', 'subject',
          'ca1Raw', 'ca1Max', 'ca1Score',
          'ca2Raw', 'ca2Max', 'ca2Score',
          'caScore',
          'examRaw', 'examMax', 'examScore',
          'totalScore', 'grade', 'gradePoint', 'remark', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'schoolId', 'registrationCode', 'studentId', 'studentName',
          'formLevel', 'stream', 'term', 'academicYear', 'subject',
          'ca1Raw', 'ca1Max', 'ca1Score',
          'ca2Raw', 'ca2Max', 'ca2Score',
          'caScore',
          'examRaw', 'examMax', 'examScore',
          'totalScore', 'grade', 'gradePoint', 'remark', 'teacherComment', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && isValidRegCode(data.registrationCode)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.formLevel is int && data.formLevel >= 1 && data.formLevel <= 4
        && data.stream is string && data.stream.size() >= 1 && data.stream.size() <= 20
        && data.term in ['Term 1', 'Term 2', 'Term 3']
        && data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60
        && data.ca1Raw is number && data.ca1Raw >= 0 && data.ca1Raw <= 1000
        && data.ca1Max is number && data.ca1Max >= 0 && data.ca1Max <= 1000 && data.ca1Raw <= data.ca1Max
        && data.ca1Score is number && data.ca1Score >= 0 && data.ca1Score <= 20
        && data.ca2Raw is number && data.ca2Raw >= 0 && data.ca2Raw <= 1000
        && data.ca2Max is number && data.ca2Max >= 0 && data.ca2Max <= 1000 && data.ca2Raw <= data.ca2Max
        && data.ca2Score is number && data.ca2Score >= 0 && data.ca2Score <= 20
        && data.caScore is number && data.caScore >= 0 && data.caScore <= 40
        && data.examRaw is number && data.examRaw >= 0 && data.examRaw <= 1000
        && data.examMax is number && data.examMax >= 0 && data.examMax <= 1000 && data.examRaw <= data.examMax
        && data.examScore is number && data.examScore >= 0 && data.examScore <= 60
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 10
        && data.gradePoint is int && data.gradePoint >= 1 && data.gradePoint <= 9
        && data.remark is string && data.remark.size() >= 1 && data.remark.size() <= 40
        && (!('teacherComment' in data) || (data.teacherComment is string && data.teacherComment.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentReportRemark(data, requireRegCode) {
      return data.keys().hasAll([
          'ownerId', 'schoolId', 'studentId', 'studentName',
          'formLevel', 'stream', 'term', 'academicYear',
          'formTeacherRemark', 'headTeacherRemark', 'nextTermOpens',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
