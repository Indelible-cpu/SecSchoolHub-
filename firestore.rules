              && get(/databases/$(database)/documents/studentPortals/$(incoming().registrationCode)).data.studentId == incoming().studentId
              && existsAfter(/databases/$(database)/documents/studentPortals/$(incoming().registrationCode)/feeSubmissions/$(submissionId))
