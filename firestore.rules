        allow delete: if isValidId(schoolId) && isValidId(recordId) && isSchoolOwner(schoolId);
      }

      // Student Disciplinary Cases (Suspensions, Rustications, Warnings): Readable by active school staff, managed ONLY by School Admin / Owner
      match /studentCases/{caseId} {
        allow get: if isValidId(schoolId) && isValidId(caseId) && isAnySchoolStaff(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isAnySchoolStaff(schoolId)
        );
        allow create: if isValidId(schoolId) && isValidId(caseId)
          && isSchoolOwner(schoolId)
          && isValidStudentCase(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(incoming().studentId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId) && isValidId(caseId)
          && isSchoolOwner(schoolId)
          && isValidStudentCase(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().studentId == existing().studentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName', 'admissionNo', 'formLevel', 'stream',
              'caseType', 'severity', 'status', 'title', 'description',
              'actionTaken', 'incidentDate', 'suspensionEndDate',
              'guardianNotified', 'recordedBy', 'updatedAt'
            ])
          );
        allow delete: if isValidId(schoolId) && isValidId(caseId) && isSchoolOwner(schoolId);
      }

      // Smart GPS Staff Timebook Configuration: Readable by active staff, configurable ONLY by School Admin / Owner
      match /timebookSettings/{configId} {
        allow get: if isValidId(schoolId) && configId == 'default' && isAnySchoolStaff(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isAnySchoolStaff(schoolId)
        );
        allow create: if isValidId(schoolId) && configId == 'default'
          && isSchoolOwner(schoolId)
          && isValidTimebookSettings(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId) && configId == 'default'
          && isSchoolOwner(schoolId)
          && isValidTimebookSettings(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'enabled', 'locationConfigured', 'locationLabel', 'schoolLatitude',
              'schoolLongitude', 'radiusMeters', 'maxAccuracyMeters', 'timezone',
              'windowStartHHMM', 'defaultDeadlineHHMM', 'categoryDeadlines',
              'workdays', 'holidays', 'reminderSlots', 'remindersEnabled',
              'updatedBy', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // Smart GPS Staff Timebook Entries: Strictly non-retrospective, time-window locked for staff; corrections by Admin only
      match /timebookEntries/{entryId} {
        allow get: if isValidId(schoolId) && isValidId(entryId) && (
          isSchoolHead(schoolId) ||
          (hasStaffAccess(schoolId) && (
            existing().staffUid == request.auth.uid ||
            existing().teacherId == staffTeacherId(schoolId)
          ))
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isSchoolHead(schoolId) ||
          (hasStaffAccess(schoolId) && existing().staffUid == request.auth.uid)
        );
        allow create: if isValidId(schoolId) && isValidId(entryId)
          && isValidTimebookEntry(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(incoming().teacherId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (
              isSchoolOwner(schoolId)
              && incoming().recordingMethod == 'Admin Recorded'
              && incoming().authorizedByUid == request.auth.uid
            ) ||
            (
              hasStaffAccess(schoolId)
              && incoming().teacherId == staffTeacherId(schoolId)
              && incoming().staffUid == request.auth.uid
              && incoming().date == formatLocalDate(blantyreTime(request.time))
              && entryId == (formatLocalDate(blantyreTime(request.time)) + '_' + incoming().teacherId)
              && incoming().recordingMethod == 'GPS Auto'
              && incoming().status == 'Present'
              && incoming().gpsVerificationStatus == 'Verified'
              && incoming().timeInServer == request.time
              && incoming().serverReceiptSignature.size() >= 16
              && isWithinTimebookWindow(schoolId, incoming().roleTitle)
            )
          );
        allow update: if isValidId(schoolId) && isValidId(entryId)
          && isSchoolOwner(schoolId)
          && isValidTimebookEntry(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().teacherId == existing().teacherId
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().authorizedByUid == request.auth.uid
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'recordingMethod', 'timeInServer', 'timeInDisplay',
              'gpsVerificationStatus', 'correctionStatus', 'correctionReason',
              'authorizedByUid', 'authorizedByName', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // Staff Correction Requests: Staff create own requests; Admin reviews and updates status
      match /timebookCorrectionRequests/{requestId} {
        allow get: if isValidId(schoolId) && isValidId(requestId) && (
          isSchoolOwner(schoolId) ||
          (hasStaffAccess(schoolId) && (
            existing().staffUid == request.auth.uid ||
            existing().teacherId == staffTeacherId(schoolId)
          ))
        );
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isSchoolOwner(schoolId) ||
          (hasStaffAccess(schoolId) && existing().staffUid == request.auth.uid)
        );
        allow create: if isValidId(schoolId) && isValidId(requestId)
          && isAnySchoolStaff(schoolId)
          && isValidTimebookCorrectionRequest(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(incoming().teacherId))
          && incoming().staffUid == request.auth.uid
          && (isSchoolOwner(schoolId) || incoming().teacherId == staffTeacherId(schoolId))
          && incoming().status == 'Pending'
          && incoming().reviewedByUid == ''
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId) && isValidId(requestId)
          && isSchoolOwner(schoolId)
          && isValidTimebookCorrectionRequest(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().teacherId == existing().teacherId
          && incoming().staffUid == existing().staffUid
          && incoming().date == existing().date
          && incoming().explanation == existing().explanation
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().reviewedByUid == request.auth.uid
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminNote', 'reviewedByUid', 'reviewedByName', 'reviewedAtIso', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // Immutable Timebook Correction Audit Logs: Append-only by School Admin / Owner; readable by Heads/Owner
      match /timebookAuditLogs/{auditId} {
        allow get: if isValidId(schoolId) && isValidId(auditId) && isSchoolHead(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isSchoolHead(schoolId)
        );
        allow create: if isValidId(schoolId) && isValidId(auditId)
          && isSchoolOwner(schoolId)
          && isValidTimebookAuditLog(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().authorizedByUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      // Immutable Suspicious GPS & Anti-Tampering Security Logs
      match /timebookSuspiciousLogs/{logId} {
        allow get: if isValidId(schoolId) && isValidId(logId) && isSchoolHead(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isSchoolHead(schoolId)
        );
        allow create: if isValidId(schoolId) && isValidId(logId)
          && isAnySchoolStaff(schoolId)
          && isValidTimebookSuspiciousLog(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().staffUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      // Owner-Only Automated Firestore Database Backup Settings
      match /backupSettings/{configId} {
        allow get: if isValidId(schoolId) && configId == 'default' && isSchoolOwner(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isValidId(schoolId) && configId == 'default'
          && isSchoolOwner(schoolId)
          && isValidBackupSettings(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().updatedByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId) && configId == 'default'
          && isSchoolOwner(schoolId)
          && isValidBackupSettings(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().schoolId == existing().schoolId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedByUid == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'autoBackupEnabled', 'cadence', 'preferredHourUTC', 'retentionCount',
              'storageTarget', 'lastBackupAtIso', 'lastBackupId', 'lastBackupStatus',
              'nextBackupDueIso', 'updatedByUid', 'updatedByName', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // Owner-Only Immutable Firestore Snapshot Backup History Logs
      match /backupLogs/{backupId} {
        allow get: if isValidId(schoolId) && isValidId(backupId) && isSchoolOwner(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isValidId(schoolId) && isValidId(backupId)
          && isSchoolOwner(schoolId)
          && isValidBackupSnapshotLog(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().snapshotId == backupId
          && incoming().triggeredByUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(schoolId) && isValidId(backupId) && isSchoolOwner(schoolId);
      }
    }
  }
}
