            ])
          );
        allow delete: if isValidId(schoolId) && isValidId(invoiceId) && isBursarStaff(schoolId);
      }

      // Fee Payments: Bursar & Head Teacher / Owner only (immutable receipts)
      match /feePayments/{paymentId} {
        allow get: if isValidId(schoolId) && isValidId(paymentId) && isBursarStaff(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isBursarStaff(schoolId)
        );
        allow create: if isValidId(schoolId) && isValidId(paymentId)
          && isBursarStaff(schoolId)
          && isValidFeePayment(incoming())
          && incoming().ownerId == schoolOwnerId(schoolId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/feeInvoices/$(incoming().invoiceId))
          && getAfter(/databases/$(database)/documents/schools/$(schoolId)/feeInvoices/$(incoming().invoiceId)).data.totalPaid
             == get(/databases/$(database)/documents/schools/$(schoolId)/feeInvoices/$(incoming().invoiceId)).data.totalPaid + incoming().amount
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(schoolId) && isValidId(paymentId) && isBursarStaff(schoolId);
      }

      // Student Fee Payment Reference Submissions: Student create + Bursar review
      match /feeSubmissions/{submissionId} {
        allow get: if isValidId(schoolId) && isValidId(submissionId) && isBursarStaff(schoolId);
        allow list: if isVerified() && (
          existing().ownerId == request.auth.uid ||
          isBursarStaff(schoolId)
        );
        allow create: if isValidId(schoolId) && isValidId(submissionId)
          && isValidFeeSubmission(incoming())
          && incoming().schoolId == schoolId
          && incoming().ownerId == schoolOwnerId(schoolId)
          && incoming().status == 'Pending'
          && incoming().reviewNote == ''
          && incoming().receiptNo == ''
          && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(incoming().studentId))
          && incoming().createdAt == request.time
