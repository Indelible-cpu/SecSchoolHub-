rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Authentication & Role Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password' ||
        ('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['firestore730@gmail.com', 'dicksonpetroj1@gmail.com'])
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['firestore730@gmail.com', 'dicksonpetroj1@gmail.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function isValidRegCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 32;
    }

    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId));
    }

    function isSchoolOwner(schoolId) {
      return isVerified() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/schools/$(schoolId)) && schoolDoc(schoolId).data.ownerId == request.auth.uid)
      );
    }

    function staffAccessKey(email) {
      return 'stf_' + email.lower().replace('[^a-z0-9]', '_');
    }

    function hasStaffAccess(schoolId) {
      return isVerified()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email)))
        && get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.status == 'Active';
    }

    function staffRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.roleTitle;
    }

    function staffTeacherId(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/staffAccess/$(staffAccessKey(request.auth.token.email))).data.teacherId;
    }

    function isSchoolHead(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in ['Head Teacher', 'Deputy Head']
      );
    }

    function isFormTeacherStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in ['Head Teacher', 'Deputy Head', 'Form Teacher', 'Form Master']
      );
    }

    function isAcademicStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in [
          'Head Teacher', 'Deputy Head', 'Head of Department', 'Form Teacher', 'Form Master', 'Subject Teacher'
        ]
      );
    }

    function isBursarStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in ['Head Teacher', 'Deputy Head', 'School Bursar']
      );
    }

    function isLibraryStaff(schoolId) {
      return isSchoolOwner(schoolId) || (
        hasStaffAccess(schoolId) && staffRole(schoolId) in [
          'Head Teacher', 'Deputy Head', 'School Librarian',
          'Head of Department', 'Form Teacher', 'Form Master', 'Subject Teacher'
        ]
      );
    }

    function isAnySchoolStaff(schoolId) {
      return isSchoolOwner(schoolId) || hasStaffAccess(schoolId);
    }

    // --- Core Master Collections ---

    // Platform Admins
    match /admins/{adminId} {
      allow get: if isVerified() && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isVerified() && (request.auth.uid == userId || isAdmin());
    }

    // Student Registration Portals (non-enumerable direct access via registrationCode)
    match /studentPortals/{registrationCode} {
      allow get: if isValidRegCode(registrationCode);
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isVerified() && (
        isAdmin() ||
        (resource != null && isSchoolHead(resource.data.schoolId)) ||
        (request.resource != null && isSchoolHead(request.resource.data.schoolId))
      );

      match /results/{assessmentId} {
        allow get, list: if isValidRegCode(registrationCode);
        allow create, update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isAcademicStaff(resource.data.schoolId)) ||
          (request.resource != null && isAcademicStaff(request.resource.data.schoolId))
        );
      }

      match /reportRemarks/{remarkId} {
        allow get, list: if isValidRegCode(registrationCode);
        allow create, update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isAcademicStaff(resource.data.schoolId)) ||
          (request.resource != null && isAcademicStaff(request.resource.data.schoolId))
        );
      }

      match /libraryLoans/{loanId} {
        allow get, list: if isValidRegCode(registrationCode);
        allow create, update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isLibraryStaff(resource.data.schoolId)) ||
          (request.resource != null && isLibraryStaff(request.resource.data.schoolId))
        );
      }

      match /reservations/{reservationId} {
        allow get, list, create: if isValidRegCode(registrationCode);
        allow update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isLibraryStaff(resource.data.schoolId))
        );
      }

      match /feeInvoices/{invoiceId} {
        allow get, list: if isValidRegCode(registrationCode);
        allow create, update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isBursarStaff(resource.data.schoolId)) ||
          (request.resource != null && isBursarStaff(request.resource.data.schoolId))
        );
      }

      match /feeSubmissions/{submissionId} {
        allow get, list, create: if isValidRegCode(registrationCode);
        allow update, delete: if isVerified() && (
          isAdmin() ||
          (resource != null && isBursarStaff(resource.data.schoolId))
        );

        match /chunks/{chunkId} {
          allow get, list, create: if isValidRegCode(registrationCode);
          allow update, delete: if isVerified() && (
            isAdmin() ||
            (resource != null && isBursarStaff(resource.data.schoolId))
          );
        }
      }
    }

    // Student Digital Libraries
    match /studentLibraries/{schoolId} {
      allow read: if true;
      allow write: if isLibraryStaff(schoolId);

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isLibraryStaff(schoolId);
      }
    }

    // Student Portal School Links
    match /studentLinks/{linkId} {
      allow get, list: if isVerified() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        resource.data.studentEmail == request.auth.token.email.lower()
      );
      allow create, update, delete: if isVerified() && (
        isAdmin() ||
        (request.resource != null && isSchoolHead(request.resource.data.schoolId)) ||
        (resource != null && isSchoolHead(resource.data.schoolId))
      );
    }

    // Staff Portal School Links
    match /staffLinks/{linkId} {
      allow get, list: if isVerified() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        resource.data.staffEmail == request.auth.token.email.lower()
      );
      allow create, update, delete: if isVerified() && (
        isAdmin() ||
        (request.resource != null && isSchoolOwner(request.resource.data.schoolId)) ||
        (resource != null && isSchoolOwner(resource.data.schoolId))
      );
    }

    // --- Schools Workspace & Subcollections ---
    match /schools/{schoolId} {
      allow get: if isVerified() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        hasStaffAccess(schoolId)
      );
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isVerified() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /staffAccess/{staffKey} {
        allow get: if isVerified() && (
          isSchoolOwner(schoolId) ||
          ('email' in request.auth.token && staffKey == staffAccessKey(request.auth.token.email))
        );
        allow list, create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /students/{studentId} {
        allow get, list: if isVerified() && isAnySchoolStaff(schoolId);
        allow create, delete: if isVerified() && isSchoolHead(schoolId);
        allow update: if isVerified() && isAnySchoolStaff(schoolId);
      }

      match /teachers/{teacherId} {
        allow get, list: if isVerified() && isSchoolHead(schoolId);
        allow create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /assessments/{assessmentId} {
        allow get, list: if isVerified() && (
          isAcademicStaff(schoolId) ||
          ('studentEmail' in resource.data && resource.data.studentEmail == request.auth.token.email.lower())
        );
        allow create, update, delete: if isVerified() && isAcademicStaff(schoolId);
      }

      match /reportRemarks/{remarkId} {
        allow get, list: if isVerified() && isAcademicStaff(schoolId);
        allow create, update, delete: if isVerified() && isAcademicStaff(schoolId);
      }

      match /feeInvoices/{invoiceId} {
        allow get, list: if isVerified() && isBursarStaff(schoolId);
        allow create, update, delete: if isVerified() && isBursarStaff(schoolId);
      }

      match /feePayments/{paymentId} {
        allow get, list: if isVerified() && isBursarStaff(schoolId);
        allow create: if isVerified() && isBursarStaff(schoolId);
        allow update: if false;
        allow delete: if isVerified() && isBursarStaff(schoolId);
      }

      match /feeSubmissions/{submissionId} {
        allow get, list: if isVerified() && isBursarStaff(schoolId);
        allow create: if true;
        allow update, delete: if isVerified() && isBursarStaff(schoolId);

        match /chunks/{chunkId} {
          allow get, list, create: if true;
          allow update, delete: if isVerified() && isBursarStaff(schoolId);
        }
      }

      match /attendance/{attendanceId} {
        allow get, list: if isVerified() && isAcademicStaff(schoolId);
        allow create, update, delete: if isVerified() && isFormTeacherStaff(schoolId);
      }

      match /smsSettings/{configId} {
        allow get, list, create, update: if isVerified() && isBursarStaff(schoolId);
        allow delete: if false;
      }

      match /smsLogs/{smsId} {
        allow get, list: if isVerified() && isBursarStaff(schoolId);
        allow create: if isVerified() && isBursarStaff(schoolId);
        allow update: if false;
        allow delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /subjects/{subjectId} {
        allow get, list: if isVerified() && isAnySchoolStaff(schoolId);
        allow create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /libraryLoans/{loanId} {
        allow get, list: if isVerified() && isLibraryStaff(schoolId);
        allow create, update, delete: if isVerified() && isLibraryStaff(schoolId);
      }

      match /libraryBooks/{bookId} {
        allow get, list: if isVerified() && isLibraryStaff(schoolId);
        allow create, update, delete: if isVerified() && isLibraryStaff(schoolId);
      }

      match /libraryTransactions/{transactionId} {
        allow get, list, create: if isVerified() && isLibraryStaff(schoolId);
        allow update, delete: if false;
      }

      match /libraryReservations/{reservationId} {
        allow get, list: if isVerified() && isLibraryStaff(schoolId);
        allow create: if true;
        allow update, delete: if isVerified() && isLibraryStaff(schoolId);
      }

      match /digitalLibrary/{resourceId} {
        allow get, list: if isVerified() && isLibraryStaff(schoolId);
        allow create, update, delete: if isVerified() && isLibraryStaff(schoolId);

        match /chunks/{chunkId} {
          allow get, list: if isVerified() && isLibraryStaff(schoolId);
          allow create, delete: if isVerified() && isLibraryStaff(schoolId);
          allow update: if false;
        }
      }

      match /announcements/{announcementId} {
        allow get, list: if isVerified() && isAnySchoolStaff(schoolId);
        allow create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /staffAttendance/{recordId} {
        allow get, list: if isVerified() && isSchoolHead(schoolId);
        allow create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /studentCases/{caseId} {
        allow get, list: if isVerified() && isAnySchoolStaff(schoolId);
        allow create, update, delete: if isVerified() && isSchoolOwner(schoolId);
      }

      match /timebookSettings/{configId} {
        allow get, list: if isVerified() && isAnySchoolStaff(schoolId);
        allow create, update: if isVerified() && isSchoolOwner(schoolId);
        allow delete: if false;
      }

      match /timebookEntries/{entryId} {
        allow get, list: if isVerified() && (
          isSchoolHead(schoolId) ||
          (hasStaffAccess(schoolId) && resource.data.staffUid == request.auth.uid)
        );
        allow create: if isVerified() && (
          isSchoolOwner(schoolId) ||
          (hasStaffAccess(schoolId) && request.resource.data.staffUid == request.auth.uid)
        );
        allow update: if isVerified() && isSchoolOwner(schoolId);
        allow delete: if false;
      }

      match /timebookCorrectionRequests/{requestId} {
        allow get, list: if isVerified() && (
          isSchoolOwner(schoolId) ||
          (hasStaffAccess(schoolId) && resource.data.staffUid == request.auth.uid)
        );
        allow create: if isVerified() && isAnySchoolStaff(schoolId);
        allow update: if isVerified() && isSchoolOwner(schoolId);
        allow delete: if false;
      }

      match /timebookAuditLogs/{auditId} {
        allow get, list: if isVerified() && isSchoolHead(schoolId);
        allow create: if isVerified() && isSchoolOwner(schoolId);
        allow update, delete: if false;
      }

      match /timebookSuspiciousLogs/{logId} {
        allow get, list: if isVerified() && isSchoolHead(schoolId);
        allow create: if isVerified() && isAnySchoolStaff(schoolId);
        allow update, delete: if false;
      }

      match /backupSettings/{configId} {
        allow get, list, create, update: if isVerified() && isSchoolOwner(schoolId);
        allow delete: if false;
      }

      match /backupLogs/{backupId} {
        allow get, list, create: if isVerified() && isSchoolOwner(schoolId);
        allow update: if false;
        allow delete: if isVerified() && isSchoolOwner(schoolId);
      }
    }
  }
}
