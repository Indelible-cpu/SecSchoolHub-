              'subject',
              'ca1Raw', 'ca1Max', 'ca1Score',
              'ca2Raw', 'ca2Max', 'ca2Score',
              'caScore',
              'examRaw', 'examMax', 'examScore',
              'totalScore', 'grade', 'gradePoint', 'remark', 'teacherComment', 'updatedAt'
            ])
          );
        allow delete: if isValidId(schoolId) && isValidId(assessmentId) && isAcademicStaff(schoolId);
