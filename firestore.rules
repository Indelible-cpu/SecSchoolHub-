        ])
        && isValidId(data.ownerId)
        && isValidId(data.schoolId)
        && data.autoBackupEnabled is bool
        && data.cadence in ['daily', 'weekly']
        && data.preferredHourUTC is int && data.preferredHourUTC >= 0 && data.preferredHourUTC <= 23
        && data.retentionCount is int && data.retentionCount >= 1 && data.retentionCount <= 60
